.pnpm-store/

# Build output
build/
*.min.js
# dist/ is intentionally committed — the minified bookmarklet is the artifact
# users install, so checking it in lets visitors diff it against the source
# to verify nothing was injected during minification.

# Env / secrets
.env
.env.*
!.env.example

# Logs
*.log

# Local scratch
scratch/
tmp/
